AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-8
# Backend intentionally ignores ANTHROPIC_MODEL.
VIBE_ZOO_BIND_HOST=127.0.0.1
VIBE_ZOO_PORT=18443
VIBE_ZOO_PUBLIC_ORIGIN=https://localhost:18443
VIBE_ZOO_DATA_DIR=.local/state
VIBE_ZOO_TLS_CERT_PATH=.local/tls/localhost.crt
VIBE_ZOO_TLS_KEY_PATH=.local/tls/localhost.key
VIBE_ZOO_ALLOWED_EXTENSION_IDS=
# Target sites need no origin registration. HTTP(S) tabs use the connected user session.
